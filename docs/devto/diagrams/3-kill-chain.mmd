graph LR
    PLANT["1️⃣ Attacker plants<br/>adversarial dir name<br/><i>(invisible Unicode)</i>"]
    READ["2️⃣ Agent reads<br/>directory listing"]
    KPA["3️⃣ <b>KILL POINT A</b><br/>stripInvisibleUnicode<br/>strips payload"]
    LLM["4️⃣ LLM processes<br/>sanitized context"]
